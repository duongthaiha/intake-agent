{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intake-agent/evidence-manifest/v1.0.0",
  "title": "Intake Agent release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "candidate",
    "evaluation",
    "artifacts",
    "approvals",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "required": [
        "commit_sha",
        "deployment_variant",
        "components"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "deployment_variant": {
          "enum": [
            "baseline",
            "hardened"
          ]
        },
        "components": {
          "type": "object",
          "required": [
            "hosted_agent",
            "prompt_agent",
            "model",
            "instructions",
            "shared_behavior",
            "toolbox",
            "mcp_contract",
            "policy",
            "template",
            "schema",
            "deterministic_packages"
          ],
          "properties": {
            "hosted_agent": {
              "type": "string",
              "minLength": 1
            },
            "prompt_agent": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "shared_behavior": {
              "type": "string",
              "minLength": 1
            },
            "toolbox": {
              "type": "string",
              "minLength": 1
            },
            "mcp_contract": {
              "type": "string",
              "minLength": 1
            },
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "template": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "deterministic_packages": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "run_id",
        "dataset_version",
        "threshold_set_version",
        "release_decision",
        "variants"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "threshold_set_version": {
          "type": "string",
          "minLength": 1
        },
        "release_decision": {
          "const": "pass"
        },
        "variants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "hosted",
              "prompt"
            ]
          },
          "minItems": 2
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256",
          "media_type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "subject",
          "decision",
          "decided_at"
        ]
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "certificate_thumbprint",
        "signed_at",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "RS256",
            "ES256"
          ]
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "certificate_thumbprint": {
          "type": "string",
          "minLength": 1
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
