[run]
source =
    src/intake_domain
branch = True
omit =
    tests/*
    evaluation/*
    */__init__.py

[report]
fail_under = 80
show_missing = True
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    @(abc\.)?abstractmethod
    \.\.\.

[html]
directory = htmlcov