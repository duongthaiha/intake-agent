# Copy this file to .env, replace placeholders, then run:
#   az login
#   intake-devui
#
# Authentication uses DefaultAzureCredential and your Azure CLI login.
# Do not add API keys, account keys, or connection strings.

# Microsoft Foundry project and model used by the local agent.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment-name>

# DevUI is restricted to local mode.
INTAKE_ENVIRONMENT=local
INTAKE_DEVUI_PORT=8080

# Option A: in-memory local development (default).
# Requests reset whenever the local process stops.
INTAKE_PERSISTENCE_BACKEND=inmemory
INTAKE_SERVICEBUS_BACKEND=inmemory
INTAKE_BLOB_BACKEND=inmemory

# Option B: persist local requests in Azure Cosmos DB.
# Replace INTAKE_PERSISTENCE_BACKEND above with "cosmos", then uncomment these
# settings. Blob and Service Bus may remain in-memory for local UI testing.
#
# INTAKE_PERSISTENCE_BACKEND=cosmos
# INTAKE_COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
# INTAKE_COSMOS_DATABASE=intake
# INTAKE_COSMOS_REQUESTS_CONTAINER=request-state
# INTAKE_COSMOS_TEMPLATES_CONTAINER=templates
# INTAKE_COSMOS_IDEMPOTENCY_CONTAINER=idempotency
#
# Your signed-in Azure identity must have Cosmos DB data-plane access. Leave
# AZURE_CLIENT_ID unset locally so DefaultAzureCredential uses `az login`.
