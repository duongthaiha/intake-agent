{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "speak": "Start a new intake request. Provide a title and a brief description to begin.",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "New Intake Request",
          "weight": "Bolder",
          "size": "Large",
          "color": "Accent",
          "wrap": true,
          "id": "heading"
        },
        {
          "type": "TextBlock",
          "text": "Complete the fields below to start capturing your requirements. Mandatory fields are marked with an asterisk (*).",
          "wrap": true,
          "spacing": "Small",
          "id": "intro"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Project Title *",
          "weight": "Bolder",
          "wrap": true,
          "id": "lbl_title"
        },
        {
          "type": "Input.Text",
          "id": "project_title",
          "placeholder": "e.g. Customer Portal Redesign",
          "label": "Project title (required)",
          "isRequired": true,
          "errorMessage": "A project title is required before you can continue.",
          "maxLength": 120,
          "style": "text"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "Brief Description *",
          "weight": "Bolder",
          "wrap": true,
          "id": "lbl_desc"
        },
        {
          "type": "Input.Text",
          "id": "project_description",
          "placeholder": "Summarise what you need and why",
          "label": "Brief description (required)",
          "isRequired": true,
          "errorMessage": "A description is required.",
          "isMultiline": true,
          "maxLength": 1000
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "Business Owner",
          "weight": "Bolder",
          "wrap": true,
          "id": "lbl_owner"
        },
        {
          "type": "Input.Text",
          "id": "business_owner",
          "placeholder": "Display name or email",
          "label": "Business owner (optional)",
          "maxLength": 120
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "Target Delivery Date",
          "weight": "Bolder",
          "wrap": true,
          "id": "lbl_date"
        },
        {
          "type": "Input.Date",
          "id": "target_date",
          "label": "Target delivery date (optional)",
          "placeholder": "YYYY-MM-DD"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Start Intake",
      "verb": "capture_field",
      "associatedInputs": "auto",
      "data": {
        "field_path": "project",
        "expected_revision": 0
      },
      "tooltip": "Save these details and begin the intake conversation",
      "style": "positive",
      "id": "btn_start"
    }
  ]
}
