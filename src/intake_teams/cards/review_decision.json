{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "speak": "Review decision. Request: ${request_title}, Revision ${current_revision}. Submitted by ${requester_name}. Review the summary and enter your decision below.",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "📋 Review Request",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true,
          "id": "heading"
        },
        {
          "type": "TextBlock",
          "text": "Request: **${request_title}** — Revision ${current_revision}",
          "wrap": true,
          "spacing": "Small",
          "id": "context"
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "id": "request_facts",
      "facts": [
        {
          "title": "Submitted by",
          "value": "${requester_name}"
        },
        {
          "title": "Submitted at",
          "value": "${submitted_at}"
        },
        {
          "title": "Quality score",
          "value": "${quality_score}/100"
        },
        {
          "title": "Template",
          "value": "${template_id} v${template_version}"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "id": "field_summary",
      "items": [
        {
          "type": "TextBlock",
          "text": "Field Summary",
          "weight": "Bolder",
          "wrap": true,
          "id": "lbl_fields"
        },
        {
          "type": "TextBlock",
          "text": "${captured_fields_summary}",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "id": "decision_section",
      "items": [
        {
          "type": "TextBlock",
          "text": "Decision *",
          "weight": "Bolder",
          "wrap": true,
          "id": "lbl_decision"
        },
        {
          "type": "Input.ChoiceSet",
          "id": "decision",
          "label": "Review decision (required)",
          "isRequired": true,
          "errorMessage": "Please select a decision before submitting.",
          "style": "expanded",
          "choices": [
            { "title": "✅ Approve — request is complete and correct", "value": "approve" },
            { "title": "🔄 Request Changes — feedback required from requester", "value": "request_changes" },
            { "title": "❌ Reject — request is not suitable", "value": "reject" }
          ]
        },
        {
          "type": "TextBlock",
          "text": "Rationale *",
          "weight": "Bolder",
          "wrap": true,
          "spacing": "Medium",
          "id": "lbl_rationale"
        },
        {
          "type": "Input.Text",
          "id": "rationale",
          "placeholder": "Explain your decision so the requester understands the next step",
          "label": "Rationale (required)",
          "isRequired": true,
          "errorMessage": "Please provide a rationale for your decision.",
          "isMultiline": true,
          "maxLength": 2000
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Submit Decision",
      "verb": "review_decision",
      "associatedInputs": "auto",
      "data": {
        "expected_revision": "${current_revision}"
      },
      "tooltip": "Submit your review decision",
      "style": "positive",
      "id": "btn_submit"
    }
  ]
}
