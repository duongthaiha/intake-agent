{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "speak": "Review ready. Your request is complete and ready to submit for review. ${quality_summary}",
  "body": [
    {
      "type": "Container",
      "style": "good",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "✅ Ready for Review",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Good",
          "wrap": true,
          "id": "heading"
        },
        {
          "type": "TextBlock",
          "text": "Request: **${request_title}** — Revision ${current_revision}",
          "wrap": true,
          "spacing": "Small",
          "id": "context"
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "id": "summary_facts",
      "facts": [
        {
          "title": "Status",
          "value": "All required fields captured"
        },
        {
          "title": "Quality score",
          "value": "${quality_score}/100"
        },
        {
          "title": "Open gaps",
          "value": "${open_gap_count}"
        },
        {
          "title": "Prepared by",
          "value": "${requester_name}"
        },
        {
          "title": "Template",
          "value": "${template_id} v${template_version}"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "id": "field_summary",
      "items": [
        {
          "type": "TextBlock",
          "text": "Captured Fields",
          "weight": "Bolder",
          "wrap": true,
          "id": "lbl_fields"
        },
        {
          "type": "TextBlock",
          "text": "${captured_fields_summary}",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Small",
      "id": "submission_note",
      "items": [
        {
          "type": "TextBlock",
          "text": "Once submitted, this revision will be locked and sent to a reviewer. You will be notified when a decision is made.",
          "wrap": true,
          "isSubtle": true,
          "size": "Small"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Submit for Review",
      "verb": "submit_request",
      "data": {
        "expected_revision": "${current_revision}"
      },
      "tooltip": "Lock this revision and send to reviewer",
      "style": "positive",
      "id": "btn_submit"
    },
    {
      "type": "Action.Execute",
      "title": "Edit a Field",
      "verb": "capture_field",
      "data": {
        "field_path": "${first_editable_field}",
        "expected_revision": "${current_revision}"
      },
      "tooltip": "Go back and edit a field before submitting",
      "id": "btn_edit"
    }
  ]
}
