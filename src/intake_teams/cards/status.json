{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "speak": "${status_speak}",
  "body": [
    {
      "type": "Container",
      "style": "${container_style}",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "${status_icon} ${status_title}",
          "weight": "Bolder",
          "size": "Small",
          "wrap": true,
          "id": "heading"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${status_message}",
      "wrap": true,
      "spacing": "Small",
      "size": "Small",
      "id": "status_body"
    },
    {
      "type": "FactSet",
      "spacing": "Small",
      "id": "status_facts",
      "isVisible": "${show_facts}",
      "facts": [
        {
          "title": "Revision",
          "value": "${current_revision}"
        },
        {
          "title": "Saved at",
          "value": "${saved_at}"
        }
      ]
    }
  ]
}
