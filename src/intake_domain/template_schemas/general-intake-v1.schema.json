{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intake-template:general-intake-v1:1.1.0",
  "title": "General Intake Form",
  "description": "Captures the information required to evaluate an enterprise request.",
  "type": "object",
  "additionalProperties": false,
  "x-intake": {
    "templateId": "general-intake-v1",
    "version": "1.1.0",
    "qualityThreshold": 0.7,
    "isActive": true
  },
  "required": [
    "project",
    "requester",
    "priority"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "title": "Project Name",
          "description": "Short name for the initiative or project",
          "type": "string"
        },
        "description": {
          "title": "Project Description",
          "description": "Brief description of what is needed and why",
          "type": "string"
        }
      }
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_unit"
      ],
      "properties": {
        "business_unit": {
          "title": "Business Unit",
          "description": "The business unit sponsoring this request",
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "title": "Budget (USD)",
          "description": "Estimated budget in USD",
          "type": "number"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_date": {
          "title": "Target Completion Date",
          "description": "Desired completion date (YYYY-MM-DD)",
          "type": "string",
          "format": "date"
        }
      }
    },
    "priority": {
      "title": "Priority",
      "description": "Business priority of the request",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
