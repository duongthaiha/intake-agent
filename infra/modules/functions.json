{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "13449060494054587026"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "functionAppName": {
      "type": "string"
    },
    "planName": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "appInsightsConnectionString": {
      "type": "string"
    },
    "workerIdentityId": {
      "type": "string"
    },
    "workerIdentityClientId": {
      "type": "string"
    },
    "cosmosEndpoint": {
      "type": "string"
    },
    "cosmosDatabase": {
      "type": "string"
    },
    "serviceBusNamespace": {
      "type": "string"
    },
    "serviceBusQueue": {
      "type": "string"
    },
    "blobEndpoint": {
      "type": "string"
    },
    "artifactsContainer": {
      "type": "string"
    },
    "keyVaultUri": {
      "type": "string"
    },
    "environmentName": {
      "type": "string"
    },
    "vnetIntegrationSubnetId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "VNet integration subnet resource ID. Leave empty to skip VNet integration."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[parameters('planName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "functionapp",
      "sku": {
        "name": "FC1",
        "tier": "FlexConsumption"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('azd-service-name', 'workers'))]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('workerIdentityId'))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
        "reserved": true,
        "httpsOnly": true,
        "keyVaultReferenceIdentity": "[parameters('workerIdentityId')]",
        "virtualNetworkSubnetId": "[if(not(empty(parameters('vnetIntegrationSubnetId'))), parameters('vnetIntegrationSubnetId'), null())]",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[format('{0}deploymentpackage', reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').primaryEndpoints.blob)]",
              "authentication": {
                "type": "UserAssignedIdentity",
                "userAssignedIdentityResourceId": "[parameters('workerIdentityId')]"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": 100,
            "instanceMemoryMB": 2048
          },
          "runtime": {
            "name": "python",
            "version": "3.11"
          }
        },
        "siteConfig": {
          "appSettings": [
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('appInsightsConnectionString')]"
            },
            {
              "name": "INTAKE_COSMOS_ENDPOINT",
              "value": "[parameters('cosmosEndpoint')]"
            },
            {
              "name": "INTAKE_COSMOS_DATABASE",
              "value": "[parameters('cosmosDatabase')]"
            },
            {
              "name": "INTAKE_SERVICEBUS_NAMESPACE__fullyQualifiedNamespace",
              "value": "[parameters('serviceBusNamespace')]"
            },
            {
              "name": "INTAKE_SERVICEBUS_QUEUE",
              "value": "[parameters('serviceBusQueue')]"
            },
            {
              "name": "INTAKE_BLOB_ENDPOINT",
              "value": "[parameters('blobEndpoint')]"
            },
            {
              "name": "INTAKE_BLOB_CONTAINER_ARTIFACTS",
              "value": "[parameters('artifactsContainer')]"
            },
            {
              "name": "INTAKE_KEYVAULT_URI",
              "value": "[parameters('keyVaultUri')]"
            },
            {
              "name": "INTAKE_ENVIRONMENT",
              "value": "[parameters('environmentName')]"
            },
            {
              "name": "AZURE_CLIENT_ID",
              "value": "[parameters('workerIdentityClientId')]"
            }
          ],
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]"
      ]
    }
  ],
  "outputs": {
    "appId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
    },
    "appName": {
      "type": "string",
      "value": "[parameters('functionAppName')]"
    },
    "defaultHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01').defaultHostName]"
    }
  }
}